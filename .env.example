# Simpleworks — Environment Variables
#
# Copy this file to `.env.local` and fill values for local development.
# Set the SAME variables in Vercel → Project → Settings → Environment Variables for production.
#
# All variables are NEXT_PUBLIC_* — they're exposed to the client bundle by design.
# If you ever add a server-only secret, do NOT prefix it NEXT_PUBLIC_.

# Formspree contact form — sign up at https://formspree.io, copy the Form ID
NEXT_PUBLIC_FORMSPREE_ID=

# Google Calendar appointment page iframe src URL
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
