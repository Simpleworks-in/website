# Simpleworks — Environment Variables
#
# Copy this file to `.env.local` and fill values for local development.
# Set the SAME variables in Vercel → Project → Settings → Environment Variables for production.

# ─── Keystatic CMS (GitHub App mode in production) ──────────────────
# These are populated automatically by Keystatic's setup wizard the
# first time you visit /keystatic on localhost. The wizard creates a
# GitHub App in your org, then dumps the values here.
#
# Once set, /keystatic in production is gated by GitHub login:
# only users with WRITE access to the Simpleworks-in/website repo
# can sign in and edit content.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ─── Public-by-design (client bundle is OK) ────────────────────────────
# If you ever add a server-only secret, do NOT prefix it NEXT_PUBLIC_.

# Formspree contact form — sign up at https://formspree.io, copy the Form ID
NEXT_PUBLIC_FORMSPREE_ID=

# Google Calendar appointment page iframe src URL
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
