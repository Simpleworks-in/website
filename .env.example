# Simpleworks — Environment Variables
#
# Copy this file to `.env.local` and fill values for local development.
# Set the SAME variables in Vercel → Project → Settings → Environment Variables for production.
#
# Values prefixed with NEXT_PUBLIC_ are exposed to the client bundle by design.
# Everything else is SERVER-ONLY — never reference these in components without a server boundary.

# ─── Keystatic CMS (server-only secrets) ───────────────────────────────
# GitHub repo where the CMS commits posts. Format: owner/repo
KEYSTATIC_GITHUB_REPO=

# GitHub OAuth app — create at https://github.com/settings/developers
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=<set-in-vercel>

# Signs Keystatic session cookies. Generate with: openssl rand -hex 32
KEYSTATIC_SECRET=<set-in-vercel>

# ─── Public-by-design (client bundle is OK) ────────────────────────────
# Formspree contact form — sign up at https://formspree.io, copy the Form ID
NEXT_PUBLIC_FORMSPREE_ID=

# Google Calendar appointment page iframe src URL (Phase 6 in handoff)
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
